---
import Base from '../../layouts/Base.astro';

const entries = Object.entries(
  import.meta.glob('./*.mdx', { eager: true })
) as [string, any][];
const notes = entries
  .map(([p, m]) => {
    const raw = m.frontmatter?.date;
    const d = raw ? (raw instanceof Date ? raw : new Date(raw)) : null;
    const date = d && !isNaN(d.getTime())
      ? d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
      : '';
    return {
      title: m.frontmatter?.title || p.split('/').pop().replace(/\.mdx$/, ''),
      raw: raw || '',
      date,
      desc: m.frontmatter?.description || '',
      url: p.replace('./', '/notes/').replace(/\.mdx$/, '/'),
    };
  })
  .sort((a, b) => (a.raw < b.raw ? 1 : -1));
---

<Base title="Notes · Johnson's notes" description="Notes and reading">
  <div class="page-head">
    <h1>Notes</h1>
    <p>Snippets of reading, tech, and life observations. Written in Markdown / MDX, with code and math support.</p>
  </div>

  {
    notes.length > 0 ? (
      <div class="post-list">
        {notes.map((n) => (
          <a class="post-row" href={n.url} style="color:inherit">
            <div>
              <div class="title">{n.title}</div>
              {n.desc && <div style="color:var(--text-faint);font-size:.85rem">{n.desc}</div>}
            </div>
            <span class="meta">{n.date}</span>
          </a>
        ))}
      </div>
    ) : (
      <p style="color:var(--text-faint)">
        Add an <code>.mdx</code> file under <code>src/pages/notes/</code> and it will appear here.
      </p>
    )
  }
</Base>
