---
import Base from '../../layouts/Base.astro';
import PyodideRunner from '../../components/PyodideRunner.astro';

const codeStats = `import numpy as np
rng = np.random.default_rng(42)
data = rng.normal(loc=100, scale=15, size=1000)
print("mean :", round(data.mean(), 2))
print("std  :", round(data.std(), 2))
print("min  :", round(data.min(), 2))
print("max  :", round(data.max(), 2))
print("median:", round(np.median(data), 2))`;

const codeHist = `import numpy as np
import matplotlib.pyplot as plt
rng = np.random.default_rng(7)
data = rng.normal(0, 1, 5000)
plt.figure(figsize=(6, 3.4))
plt.hist(data, bins=50, color="#4f46e5", alpha=0.8)
plt.title("Standard normal distribution")
plt.xlabel("value"); plt.ylabel("count")
plt.grid(alpha=0.25)
print("n:", len(data))`;

const codeFit = `import numpy as np
import matplotlib.pyplot as plt
rng = np.random.default_rng(1)
x = np.linspace(0, 10, 60)
y = 2.4 * x + 5 + rng.normal(0, 6, len(x))
# least squares
A = np.vstack([x, np.ones_like(x)]).T
k, b = np.linalg.lstsq(A, y, rcond=None)[0]
plt.figure(figsize=(6, 3.4))
plt.scatter(x, y, s=12, alpha=0.5, color="#06b6d4", label="data")
plt.plot(x, k*x+b, color="#ef4444", linewidth=2, label="fit y=%.2fx+%.2f" % (k, b))
plt.legend(); plt.grid(alpha=0.25)
plt.title("Least squares fit")
print("slope k =", round(k, 3), " intercept b =", round(b, 3))`;
